FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_TELEGRAM_BOT_NAME
ARG NEXT_PUBLIC_SMS_ENABLED
ARG NEXT_PUBLIC_MEILISEARCH_HOST
ARG NEXT_PUBLIC_MEILISEARCH_KEY
ARG NEXT_PUBLIC_DEV_AUTO_LOGIN
# Needed at build time: next.config.js bakes the /uploads rewrite destination
ARG STRAPI_SERVER_URL

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_TELEGRAM_BOT_NAME=$NEXT_PUBLIC_TELEGRAM_BOT_NAME
ENV NEXT_PUBLIC_SMS_ENABLED=$NEXT_PUBLIC_SMS_ENABLED
ENV NEXT_PUBLIC_MEILISEARCH_HOST=$NEXT_PUBLIC_MEILISEARCH_HOST
ENV NEXT_PUBLIC_MEILISEARCH_KEY=$NEXT_PUBLIC_MEILISEARCH_KEY
ENV NEXT_PUBLIC_DEV_AUTO_LOGIN=$NEXT_PUBLIC_DEV_AUTO_LOGIN
ENV STRAPI_SERVER_URL=$STRAPI_SERVER_URL

RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["npm", "run", "start"]