{
  "kind": "collectionType",
  "collectionName": "artists",
  "info": {
    "singularName": "artist",
    "pluralName": "artists",
    "displayName": "Artist",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "full_name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "email": {
      "type": "email"
    },
    "Arts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::art.art",
      "mappedBy": "Artist"
    },
    "Phone": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "files", "videos"]
    },
    "nickname": {
      "type": "string"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "country": {
      "type": "string"
    },
    "city_name": {
      "type": "string"
    },
    "birth_year": {
      "type": "integer"
    },
    "career_start_year": {
      "type": "integer"
    },
    "works_count": {
      "type": "integer"
    },
    "directions": {
      "type": "json"
    },
    "techniques": {
      "type": "json"
    },
    "subjects": {
      "type": "json"
    },
    "education": {
      "type": "string"
    },
    "exhibitions": {
      "type": "json"
    },
    "social_links": {
      "type": "json"
    },
    "messenger_type": {
      "type": "string"
    },
    "studio_location": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "profile_type": {
      "type": "enumeration",
      "enum": ["real_user", "organization"],
      "default": "real_user"
    },
    "is_ai": {
      "type": "boolean",
      "default": false
    },
    "user_uploader": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "followers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    }
  }
}
